# EditorConfig — https://editorconfig.org
# The runtime is a single HTML file with 4-space indentation; CI compares raw
# bytes against the payload budget, so consistent formatting is a correctness
# concern, not a style preference.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[*.{mjs,js}]
indent_size = 2

[Makefile]
indent_style = tab
